# Copy to backend/.env.validation (git ignored). Replace every placeholder.
# Independent project only. Do not copy the production .env.
VALIDATION_API_URL=https://metadiet-api-validation.onrender.com
VALIDATION_PROJECT_REF=replace_with_new_project_ref
SUPABASE_URL=https://replace_with_new_project_ref.supabase.co
SUPABASE_DB_URL=postgresql://postgres:REPLACE_PASSWORD@db.replace_with_new_project_ref.supabase.co:5432/postgres?sslmode=require
SUPABASE_SERVICE_KEY=REPLACE_WITH_VALIDATION_KEY
SUPABASE_JWT_SECRET=REPLACE_WITH_VALIDATION_SECRET
ENVIRONMENT=validation
ENABLE_SCHEDULER=false
LANGSMITH_TRACING=false
VALIDATION_SYNTHETIC_ONLY=true
VALIDATION_DURATION_SECONDS=7200
VALIDATION_SESSIONS=3
VALIDATION_INTERVAL_SECONDS=30
