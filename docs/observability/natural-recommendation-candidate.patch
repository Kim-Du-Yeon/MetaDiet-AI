diff --git a/backend/app/agents/coaching_route.py b/backend/app/agents/coaching_route.py
index 052eab5e..16935cbd 100644
--- a/backend/app/agents/coaching_route.py
+++ b/backend/app/agents/coaching_route.py
@@ -21,6 +21,15 @@ def simple_recommendation(state):
     if (state.get('requested_action') or state.get('pending_proposal')
             or state.get('awaiting_confirmation')):
         return False
+    # Whole-message allowlist: explicit non-saving advice only; do not strip
+    # unknown prefixes/suffixes or broaden pending/HITL eligibility.
+    if re.fullmatch(
+        r"\s*(?:기록은\s*저장하지\s*말고\s*)?(?:오늘\s*)?"
+        r"(?:아침|점심|저녁)\s*메뉴\s*(?:하나만|한\s*가지를)\s*"
+        r"(?:짧게|간단히)\s*추천(?:\s*해\s*줘|\s*해주세요)[.!?\s]*",
+        state.get("message", ""),
+    ):
+        return True
     return bool(re.fullmatch(
         r'\s*(?:오늘\s*)?(?:아침|점심|저녁)\s*(?:(?:메뉴|식단)(?:을)?\s*)?'
         r'추천(?:\s*해\s*줘|\s*해주세요)?[.!?\s]*'
