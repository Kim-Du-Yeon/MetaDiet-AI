# Gemini agent upgrade (existing values preserved)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Model IDs live in env; fixed-purpose call sites select the appropriate model.
# Keep disabled until the matched live evaluation passes; false is the rollback.
MODEL_ROUTING_ENABLED=false
GEMINI_SIMPLE_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_EVAL_MODEL=gemini-3.1-pro-preview
# Verified read-only follow-ups only. Set default to restore provider behavior.
COACHING_THINKING_LEVEL=low
BRIEF_FOLLOWUP_ANSWER=false
FOLLOWUP_MODEL=default
FOLLOWUP_TOOLS_ENABLED=true
COACHING_CLIENT_REUSE=false
# Opt-in diagnostic path switches aiohttp to HTTPX; compare only like-for-like.
COACHING_TRANSPORT_TIMING=false
COACHING_DELIVERY=invoke
FIRST_COACHING_MODE=low
# Set FIRST_COACHING_MODE=off to restore Supervisor routing for first recommendations.
EVAL_MODEL_TIMEOUT_SECONDS=90
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=0
AGENT_MAX_MODEL_CALLS=12
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_REPLANS=2
AGENT_MAX_VALIDATION_ATTEMPTS=3
AGENT_TIMEOUT_SECONDS=120
DEEP_AGENT_MAX_MODEL_CALLS=20
DEEP_AGENT_MAX_TOOL_CALLS=30
DEEP_AGENT_TIMEOUT_SECONDS=180

EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=3072
PINECONE_NAMESPACE=metadiet-gemini-1157903c493dbb5d759f
